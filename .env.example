# Required
DATABASE_URL=postgresql://user:password@host:5432/app_db

# Optional tuning (defaults shown)
OW_MAX_FILE_MB=10
# Total upload budget per request. 0 = off. Set to 4 on Vercel (4.5 MB platform cap).
OW_MAX_BATCH_MB=0
OW_MAX_FILES=8
OW_IMAGE_TIMEOUT_MS=15000
OW_IMAGE_CONCURRENCY=2
# Decoder cap: width × height × frames. Protects against decompression bombs.
OW_MAX_DECODED_PIXELS=24000000
OW_MAX_CSS_CHARS=400000
# ZIP response budget. 0 = off. Set to 4 on Vercel.
OW_MAX_ZIP_MB=0
# Artifact retention in hours (default 720 = 30 days). Not a hard 24h product rule.
OW_ARTIFACT_TTL_HOURS=720
OW_AUDIT_MAX_HTML_KB=1500
OW_AUDIT_MAX_RESOURCE_KB=800
OW_AUDIT_MAX_RESOURCES=24
OW_AUDIT_TIMEOUT_MS=8000
# Optional. When set, PageSpeed Insights lab + CrUX field metrics are attached.
# PAGESPEED_API_KEY=
# Postgres pool size. Keep at 1–3 on serverless.
OW_PG_POOL_MAX=3
